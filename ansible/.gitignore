# Fichiers de rejeu Ansible (générés en cas d'échec)
*.retry

# Fichiers de données ou secrets locaux (inventaires dynamiques ou variables non versionnées)
*.secret
*.vault
*.vars
vault.*
vars.*
secrets.yml
local.yml
host_vars/local_*
group_vars/local_*
# Variables et secrets Ansible
***/vars.yml
***/vars.yaml
***/vault.yml
***/vault.yaml
***/*vault*
***/*secret*
inventories/prod/hosts
inventories/local/group_vars/*
inventories/local/host_vars/*
inventories/prod/group_vars/*
inventories/prod/host_vars/*
# Rôles téléchargés via Ansible Galaxy (si vous ne souhaitez pas les versionner)

# Collections téléchargées
collections/

# Environnement virtuel Python (si utilisé pour installer Ansible)
venv/
env/
.env

# Cache Python et fichiers compilés
__pycache__/
*.py[cod]

# IDE et éditeurs (VS Code, JetBrains)
.vscode/
.idea/
*.swp
*.swo

# Système d'exploitation
.DS_Store
Thumbs.db